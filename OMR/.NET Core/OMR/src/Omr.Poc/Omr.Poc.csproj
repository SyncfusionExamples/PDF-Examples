<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Omr.Poc</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Syncfusion.Pdf.Net.Core" Version="34.2.5" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Omr.Engine">
      <HintPath>..\..\lib\Omr.Engine.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\Omr.Pdf\Omr.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\templates\*.json" CopyToOutputDirectory="PreserveNewest" Link="templates\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
